+                    "custom_agents_path": "",
+                    "functions_path": "",
+                },
+            }
+        ),
+    )
+    monkeypatch.setattr(
+        admin,
+        "validate_cache",
+        Mock(
+            return_value={
+                "success": True,
+                "outputs": {"cache_stats": {}, "removed_entries": 0},
+            }
+        ),
+    )
